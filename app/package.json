{
  "name": "voicepilot-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VoicePilot 桌面端 — Electron + React",
  "main": "electron/main.js",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "hmr": "vite",
    "dev": "VP_DEV_URL=http://localhost:5173 electron .",
    "typecheck": "tsc --noEmit",
    "dist:win": "node scripts/prepack-check.mjs && vite build && electron-builder --win",
    "dist:win:portable": "node scripts/prepack-check.mjs && vite build && electron-builder --win portable",
    "dist:mac": "node scripts/prepack-check.mjs && vite build && electron-builder --mac"
  },
  "dependencies": {
    "opencc-js": "^1.4.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.voicepilot.app",
    "productName": "VoicePilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "build/**/*",
      "shared/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/voicepilot-icon.ico"
    },
    "mac": {
      "target": ["dir", "dmg"],
      "identity": null,
      "icon": "build/voicepilot-icon-512.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "VoicePilot 需要使用麦克风进行语音识别",
        "NSAudioCaptureUsageDescription": "VoicePilot 需要使用麦克风进行语音识别",
        "LSEnvironment": {
          "NODE_USE_SYSTEM_CA": "1"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
