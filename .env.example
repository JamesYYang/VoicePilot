# 复制本文件为 .env 并填入真实值。.env 已在 .gitignore 中，不会被提交。
#
# 两个值都在百炼控制台获取：
#   https://bailian.console.aliyun.com/  →  右上角头像 → API-KEY
#   业务空间 ID：控制台「业务空间」页面，或 API-KEY 页面同屏显示

# API Key。用于 WebSocket 握手请求头：Authorization: Bearer <此值>
DASHSCOPE_API_KEY=

# 业务空间 ID（Workspace ID）。注意它有两个用途，缺一不可：
#   1. 拼 WebSocket 地址：wss://{此值}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
#   2. 可选请求头 X-DashScope-WorkSpace
# 只有 API Key 没有它，连不上实时识别服务。
DASHSCOPE_WORKSPACE_ID=
