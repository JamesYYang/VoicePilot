# ===== 凭证（绝不入库） =====
.env
.env.local
*.key
*.pem

# ===== Node =====
node_modules/
dist/
.npmrc

# 例外：app/.npmrc 只配国内镜像地址（electron / electron-builder 二进制），
# 不含任何凭证，必须入库 —— 否则重装依赖或跑 CI 时会因连不上 GitHub 而
# 下载 Electron 二进制失败，且报错是 npm install 成功但 electron 起不来。
!app/.npmrc

# ===== Rust / Tauri（轨道 B 后续使用） =====
target/
**/*.rs.bk
Cargo.lock.orig
apps/*/src-tauri/gen/

# ===== Spike 产物 =====
# 录音音频体积大且含个人语音，不入库；
# 但对应的 ground truth 转写文本（.txt）必须入库，测试集靠它复现。
spike/audio/*.wav
spike/audio/*.mp3
spike/results/
*.log

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
